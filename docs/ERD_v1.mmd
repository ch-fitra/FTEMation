erDiagram
    USERS ||--o{ IMPORTS : uploads
    IMPORTS ||--o{ EMPLOYEES : contains
    IMPORTS ||--o{ ACTIVITIES : contains
    EMPLOYEES ||--o{ ACTIVITIES : performs
    IMPORTS ||--o{ ANALYSIS_RUNS : analyzed_by
    ANALYSIS_RUNS ||--o{ ACTIVITY_ANALYSES : produces
    ACTIVITIES ||--o{ ACTIVITY_ANALYSES : evaluated_in
    ACTIVITY_GROUPS ||--o{ ACTIVITY_ANALYSES : categorizes

    USERS {
        bigint id PK
        string name
        string email UK
        string password
    }
    IMPORTS {
        bigint id PK
        bigint user_id FK
        string filename
        string file_path
        string status
    }
    EMPLOYEES {
        bigint id PK
        bigint import_id FK
        string employee_code
        string name
        string department
        string job_title "optional; not in Excel"
    }
    ACTIVITIES {
        bigint id PK
        bigint import_id FK
        bigint employee_id FK
        string activity_code
        string activity_name
        text description
        string frequency
        decimal volume
        decimal duration_minutes
        decimal fte
    }
    ANALYSIS_RUNS {
        bigint id PK
        bigint import_id FK
        string model_name
        string prompt_version
        json config_snapshot
        json summary_json "AI summaries by employee/department"
        string status
        int input_tokens
        int output_tokens
    }
    ACTIVITY_GROUPS {
        bigint id PK
        string code UK
        string name
        text description
    }
    ACTIVITY_ANALYSES {
        bigint id PK
        bigint analysis_run_id FK
        bigint activity_id FK
        bigint activity_group_id FK
        string automation_level
        text reason
        text recommendation
        json factors
        string risk_level
        string effort_level
        boolean oversight_required
        text oversight_note
        decimal estimated_fte_saving
        string status
        string cache_key
        string error_message
    }
